  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "clean:cache": "node -e \"require('fs').rmSync('.next/cache',{recursive:true,force:true})\"",
    "prebuild": "echo prebuild",
    "build:fresh": "npm run clean && next build",
    "rebuild": "npm run clean && next build",
    "prod:start": "npm run build:fresh && next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.0.0"
  },
